{
  "name": "@nomad/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:registration": "node --test \"app/(protected)/registration/registration-utils.test.mjs\"",
    "test:auth": "node --test app/auth/authLogic.test.mjs",
    "test:validation": "vitest run app/validation",
    "test:routing": "vitest run __tests__/session-routing.test.tsx",
    "test": "npm run test:registration && npm run test:auth && npm run test:validation && npm run test:routing && npm run test:auth-ui",
    "test:auth-ui": "vitest run app/auth/AuthForm.test.tsx"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.6",
    "aws-amplify": "^6.20.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/dom": "^10.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
